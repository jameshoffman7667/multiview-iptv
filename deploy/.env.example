# Copy to .env next to compose.yaml. Names and safe defaults only; real values stay out of git.
# Host and container port (the same number). The server's port register assigns the real one.
PORT=1234
# Where the data lives on the host (a folder owned by uid 1000), or leave empty for Docker named volumes.
# DATA_PATH=/srv/iptv/data
# REC_PATH=/srv/iptv/recordings
# REWIND_PATH=/srv/iptv/rewind
